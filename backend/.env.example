# ==============================================================
# Meta / Instagram Backend Environment Variables
# IMPORTANT: Rotate any credentials previously exposed in testing.
# Never commit real secrets to GitHub or public repositories.
# ==============================================================

# Your Meta App ID (from developers.facebook.com)
META_APP_ID="YOUR_META_APP_ID"

# Your Meta App Secret (Keep secret! Only on this backend server)
META_APP_SECRET="YOUR_META_APP_SECRET"

# Long-lived Instagram Graph API User Access Token
INSTAGRAM_ACCESS_TOKEN="YOUR_INSTAGRAM_ACCESS_TOKEN"

# Custom verification secret token that YOU choose and set in Meta Webhooks
WEBHOOK_VERIFY_TOKEN="YOUR_WEBHOOK_VERIFY_TOKEN"

# Port for the Node.js server
PORT=3000
