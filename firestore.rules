rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profile
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || true);
    }

    // Connected Instagram accounts collection
    match /instagram_accounts/{instagramAccountId} {
      allow read, write: if isSignedIn();
    }

    // Default deny other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
